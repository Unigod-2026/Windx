# windx 环境变量模板。
# 复制为 .env 并填写真实值;真值进 .gitignore,本文件走 git。
# 字段顺序与 backend/app/config.py Settings 类一一对应。

# ---- Process / infra --------------------------------------------------
APP_PORT=18083
TZ=Asia/Shanghai
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

# ---- Molizhishu (legacy,本期不主动调用) -----------------------------
MOLIZHISHU_TOKEN=
MOLIZHISHU_BASE_URL=https://business-api.molizhishu.com/api/business/monitor
MOLIZHISHU_CITY_URL=https://business-api.molizhishu.com/api/business/eip-edge/ports/city-info
MOLIZHISHU_CALLBACK_URL=
MOLIZHISHU_TIMEOUT_SECONDS=30
MOLIZHISHU_SYNC_ENABLED=True
MOLIZHISHU_SYNC_INTERVAL_SECONDS=300
MOLIZHISHU_SYNC_LIMIT=50
MOLIZHISHU_ALLOW_API_KEY_UPDATE=False

# ---- LLM (Anthropic-compatible) -------------------------------------
# LLM_MODE=llm 走 LLMClient(本地默认);=molizhishu 走 MolizhishuClient。
# 本地 dev 不接 LLM 也行(留空),只在跑监控任务时才需要真 API key。
LLM_MODE=molizhishu
LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ROUNDS=6
LLM_WEB_FETCH_MAX_BYTES=20480
LLM_MAX_CONCURRENCY=4

# ---- Logos / uploads --------------------------------------------------
LOGO_STORAGE_DIR=./backend/data/logos
LOGO_MAX_BYTES=2097152

# ---- Logging --------------------------------------------------------
LOG_DIR=./logs
LOG_LEVEL=INFO

# ---- JWT -------------------------------------------------------------
# 必填,长度 >= 1。本地 dev 用 `openssl rand -hex 32` 生成;生产同样。
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ---- Monitoring schedule (per-project weekly runs) -------------------
MONITOR_DEFAULT_HOUR=12
MONITOR_DEFAULT_MINUTE=30

# ---- Billing ----------------------------------------------------------
# 单次 LLM API 调用费用(元)。前端「编辑监控项目」Modal 底部按
# cost × 调用次数 显示预计费用。值仅用于 UI 展示,实际计费以 LLM
# 提供方账单为准。
API_COST_PER_CALL=0.24