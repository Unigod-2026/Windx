# Environment (NEVER commit secrets)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
# Vite config 的 tsc 编译产物:已被本仓 tsconfig 跟踪,实际只是 vite dev
# 时偶尔重生成的中间产物,各机 mtime 不一致会污染 PR/部署 diff。
/frontend/vite.config.js
/frontend/vite.config.d.ts

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Logs / runtime data
backend/logs/
backend/data/
scripts/.logs/

# Local DB files (sqlite dev db)
*.db
*.sqlite

# ---------------------------------------------------------------------------
# Production deployment exclusions
# ---------------------------------------------------------------------------
# 本节下的内容是开发期产物,不带去服务器:
#   - 内部规划 / spec / 参考文档
#   - Claude Code session 元数据
#   - 一次性测试脚本 / mock 文件
#   - 后端测试套件(服务器不跑 pytest)
# 部署时若用 `git archive` / `rsync`,配合这些 pattern 即可。

# Dev-only docs
/CLAUDE.md
/api调用prompt.md
/需求.md
/test.md
/docs/

# Claude Code session state
/.claude/

# Playwright local artifacts (浏览器调试 / 截图残留,各机本地重生成)
/.playwright-mcp/
/.playwright-screenshots/

# Frontend probe / verification scripts (committed or not)
/probe.mjs
/test_modal.mjs
/verify-question-tab.mjs
/frontend/test_question_page_perf.mjs
/frontend/probe.mjs
/frontend/test_modal.mjs
/frontend/verify-question-tab.mjs
/frontend/verify-toolbar-dropdown.mjs
/frontend/check-name-save.mjs
/frontend/screenshot-issue.mjs

# Frontend dev runtime
/frontend.log
/frontend/pnpm-lock.yaml

# WIP / one-off backfill scripts (not part of the deployable backend)
/scripts/
/backend/scripts/refresh_one_task.py
/backend/scripts/test_monitorkeywords.py
/backend/scripts/trigger_project_38.py
/test2.md

# Backend test suite
/backend/tests/